# show network zone

Cluster
    name                        : Cluster
    antispoof-enable            : off
    antispoof-negate            : off
    dos-protection-syn          :
        enabled            : off
        aggregate          : off
        alert-threshold    : 3000
        drop-threshold     : 6000
    dos-protection-udp          :
        enabled            : off
        aggregate          : off
        alert-threshold    : 3000
        drop-threshold     : 6000
    dos-protection-icmp         :
        enabled            : off
        aggregate          : off
        alert-threshold    : 100
        drop-threshold     : 200
    services-access             :
        service              : Any ICMP
        allowed-addresses    : Any
        enabled              : on
 
        service              : ha
        allowed-addresses    : Any
        enabled              : on
 
        service              : Admin Console
        allowed-addresses    : Any
        enabled              : on
 
    sessions-limit-enabled      : off
    sessions-limit-threshold    : 0
 
DMZ
    name                        : DMZ
    antispoof-enable            : off
    antispoof-negate            : off
    dos-protection-syn          :
        enabled            : on
        aggregate          : off
        alert-threshold    : 3000
        drop-threshold     : 6000
    dos-protection-udp          :
