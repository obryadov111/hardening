    src.zone = "VPN for remote access" \
    dst.zone = (Untrusted, Trusted) \
    desc("Example NAT rule which allows traffic NAT-ting from zone VPN for remote access to Trusted and Untrusted zones.This or similar rule should be created to allow Remote access VPN users to have access to Internet and LAN. This is an example rule which can be changed or deleted if necessary.") \
