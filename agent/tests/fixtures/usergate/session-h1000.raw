[content.1 " Content Rules "]
 % ----------------- 1 --- Content Rules --------------
PASS \
    url = lib.url("Education institutions") \
    src.zone = Trusted \
    desc("Content filtering rule which allows access to the list of URLs. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    enabled(false) \
    name("Example white list")
% ----------------- 2 --- Content Rules --------------
DENY \
    url = lib.url("Compliance to RU (custom 460)", "Compliance to RU RKN (URL)", "Phishing sites") \
    src.zone = Trusted \
    desc("Content filtering rule which prohibit access to the list of URLs. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    enabled(false) \
    name("Example black list")
% ----------------- 3 --- Content Rules --------------
DENY \
    category = lib.category(Threats) \
    src.zone = Trusted \
    desc("Content filtering rule which prohibit access to the sites in group of categories Threats. Recommended to keep this rule active for security reasons. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    redirect(302, "http://127.0.0.1") \
    enabled(false) \
    name("Example threats sites")
% ----------------- 4 --- Content Rules --------------
DENY \
    url = lib.url("List of search engines without safesearch capability") \
    src.zone = Trusted \
    desc("Content filtering rule which redirects all requests to the list of search engines which do not provide safe search functionality to bing.com (safe search capable). Recommended to keep active for parental control. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    redirect(302, "https://bing.com") \
    enabled(false) \
    name("Example redirect to safesearch engines")
% ----------------- 5 --- Content Rules --------------
DENY \
    category = lib.category(Threats, "Parental Control") \
    src.zone = Trusted \
    desc("Content filtering rule which prohibits access to sites belonging to the group of categories Parental control and Threats. Recommended to keep active for parental control. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    enabled(false) \
    name("Example parental control by categories")
% ----------------- 6 --- Content Rules --------------
DENY \
    category = lib.category("Recommended for morphology checking") \
    morphology = lib.morphology(Profanity, Drugs, Pornography, Suicide, Terrorism, "Compliance to RU (Custom 460)", Gambling) \
    src.zone = Trusted \
    desc("Content filtering rule which blocks access to sites belonging to the group of categories Recommended for morphology checking AND if they contain phrases prohibited by selected morphology dictionaries. Recommended to keep active for parental control. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    enabled(false) \
    name("Example parental control by morphology")
% ----------------- 7 --- Content Rules --------------
DENY \
    virus_usergate = yes \
    category = lib.category("Recommended for virus check") \
    src.zone = Trusted \
    desc("Content filtering rule which blocks access to web pages where virus is found. Recommended to keep active for security reasons. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    enabled(false) \
    name("Example AV check")
% ----------------- 8 --- Content Rules --------------
WARNING \
    category = lib.category(Productivity) \
    src.zone = Trusted \
    desc("Content filtering rule which shows warning page when users try to access sites in Productivity category. This is an example rule which can be changed or deleted if necessary.") \
    rule_log(yes) \
    enabled(false) \
    name("Example Non-productive sites")
% ----------------- 9 --- Content Rules --------------
DENY \
    url = lib.url("Compliance to RU RKN (URL)") \
    dst.zone = Untrusted \
    desc("Пример правила, блокирующего доступ к URL, находящихся в списке Роскомнадзора. Для работы данного правила необходима активная подписка ATP. Данное правило создано как пример, может быть изменено или удалено при необходимости.") \
    rule_log(yes) \
    enabled(false) \
    name("Example block RU RKN by URL list")
