    enabled(false) \
    name("NAT from Trusted to Untrusted")\
    nat
% ----------------- 2 -----------------
OK \
    src.zone = DMZ \
    dst.zone = Untrusted \
    desc("NAT rule which allows traffic NAT-ting from DMZ zone to Untrusted zone. This is an example rule which can be changed or deleted if necessary.") \
    enabled(false) \
