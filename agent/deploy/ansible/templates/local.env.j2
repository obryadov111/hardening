# Управляется Ansible (agent/deploy/ansible/hardening-agent.yml) — правки вручную будут перезаписаны.
HARDENING_API_URL={{ hardening_server }}
# ключ площадки: при первом запуске агент регистрирует хост и дальше работает с ключом хоста (host.json)
HARDENING_AGENT_API_KEY={{ hardening_site_key }}
HARDENING_PACK_PUBLIC_KEY={{ hardening_pack_public_key }}
{% if hardening_pin_effective %}
HARDENING_PIN_SHA256={{ hardening_pin_effective }}
{% endif %}
{% if hardening_ca_file %}
HARDENING_CA_FILE={{ hardening_ca_file }}
{% endif %}
{% if hardening_proxy %}
HARDENING_PROXY={{ hardening_proxy }}
{% endif %}
HARDENING_ENVIRONMENT={{ hardening_environment }}
HARDENING_CRITICALITY={{ hardening_criticality }}
HARDENING_SCAN_LABEL={{ hardening_scan_label }}
HARDENING_EXTRA_ARGS={{ '--collect-identity' if hardening_collect_identity | bool else '' }}
