# /etc/hardening-agent/<экземпляр>.env — права 600, владелец root:hardening-agent (0640) или root (0600).
# Ключи здесь, а не в unit-файле и не в истории shell.

# Адрес сервера (без /api). Только https:// — http:// агент принимает лишь для localhost
# (или с --allow-http в HARDENING_EXTRA_ARGS внутри VPN/стенда).
HARDENING_API_URL=https://hardening.example.com
# Ключ агента для этого объекта: интерфейс → «Агенты» → «Новый ключ» (показывается один раз)
HARDENING_AGENT_API_KEY=<AGENT_API_KEY>
# Открытый ключ подписи паков (Ed25519): интерфейс → «Агенты». Подписать им нельзя — это не секрет.
HARDENING_PACK_PUBLIC_KEY=<PACK_PUBLIC_KEY>
# Старая схема — общий ключ HMAC (PACK_SIGNING_KEY сервера); при HARDENING_PACK_PUBLIC_KEY не нужен.
#HARDENING_PACK_KEY=<PACK_SIGNING_KEY>

# Связь с сервером (по необходимости):
# закрепление ключа сервера — отпечаток выдаёт `collector.py --api-url <адрес> --environment x --show-server-pin`
# или deploy/enable_https.sh на сервере; можно два через запятую (текущий и резервный)
#HARDENING_PIN_SHA256=sha256//<BASE64>
# свой корневой сертификат (TLS-инспекция в сети заказчика, внутренний УЦ)
#HARDENING_CA_FILE=/etc/hardening-agent/ca.pem
# корпоративный прокси (служба не видит прокси из окружения пользователя)
#HARDENING_PROXY=http://proxy.corp:3128

HARDENING_ENVIRONMENT=prod
HARDENING_CRITICALITY=medium
HARDENING_SCAN_LABEL=плановый

# Дополнительные аргументы collector.py. Для этого хоста — пусто.
# Для сетевого устройства (отдельный экземпляр, например sw-core.env):
#   HARDENING_EXTRA_ARGS=--ssh-host 10.0.0.1 --ssh-user audit --ssh-key /etc/hardening-agent/audit_ed25519
# Устройство должно быть в known_hosts пользователя hardening-agent (проверка ключа хоста не отключается).
HARDENING_EXTRA_ARGS=
