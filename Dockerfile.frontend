# Продакшен-фронтенд: сборка Vite + nginx без root (deploy/nginx.conf, deploy/restart_frontend.sh).
FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Явно, а не только по умолчанию образа: пользователь nginx (uid 101), не root.
USER 101
EXPOSE 8080
